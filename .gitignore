# dependencies
node_modules/

# build output (regenerated by `npm run dist`)
dist/
dist-pack/
build-staging/

# eval run artifacts, reports can describe private repos, never commit them
eval-results/

# PRIVATE answer keys, derived from closed-source apps, must NOT be published.
# Public answer keys, if any, should be added back explicitly with a negation
# rule below (e.g. `!answer-key/sample-app/`).
answer-key/*/

# Private working docs, contain numbers/names derived from a closed-source app.
# The public design write-up is DESIGN.md; scrub + un-ignore these if you want
# any of them published.
VISION.md
DECISIONS.md
HANDOFF_MAPPING.md

# Private-app-specific one-off scripts (hard-wired paths to a closed-source repo).
# Not used by the core harness; kept local.
tools/genQuestions.mjs
tools/verifySemantic.mjs

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# scratch
*.tmp
retrieval-selftest.json
retrieval-boottest.txt
tools/pack.mjs
build/
