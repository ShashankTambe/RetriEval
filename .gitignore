# dependencies
node_modules/

# build output (regenerated by `npm run dist`)
dist/
dist-pack/
build-staging/

# eval run artifacts, reports can describe private repos, never commit them
eval-results/

# PRIVATE answer keys, derived from closed-source apps, must NOT be published.
# Public answer keys, if any, should be added back explicitly with a negation
# rule below (e.g. `!answer-key/sample-app/`).
answer-key/*/

# Markdown docs are kept out of the repo; only the README is published.
# (This also covers private working docs like VISION/DECISIONS derived from a
# closed-source app.)
*.md
!README.md

# Private-app-specific one-off scripts (hard-wired paths to a closed-source repo).
# Not used by the core harness; kept local.
tools/genQuestions.mjs
tools/verifySemantic.mjs

# Benchmark target repos must NEVER be committed here. They belong to other
# people under their own licenses, and this repo publishes aggregate metrics
# only, never third-party source. Keep clones outside the project entirely;
# this is only a backstop for when one lands here by accident. A directory
# convention rather than a list of names, so it does not rot as targets change.
/repos/
/test-repos/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# scratch
*.tmp
retrieval-selftest.json
retrieval-boottest.txt
tools/pack.mjs
build/
